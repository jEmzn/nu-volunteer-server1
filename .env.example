# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgres://nuvol:change-me@localhost:5432/nuvol
# At least 32 random bytes each, and different from each other: openssl rand -base64 48
JWT_SECRET=
QR_SECRET=
# Used to build the URL inside the QR. Include the path if the site is not at the root.
WEB_ORIGIN=http://localhost:5173
# Comma separated
CORS_ORIGINS=http://localhost:5173
PORT=3000
TZ_DISPLAY=Asia/Bangkok
# Hops of reverse proxy in front of the API. Set to 1 behind Nginx, or every user counts as one IP in the rate limits.
TRUST_PROXY=0
LOG_LEVEL=info
DB_POOL_MAX=20
# Rate limits per minute
RATE_AUTH_SUP=5
RATE_AUTH_STUDENT=600
RATE_CLAIMS=10
# Every other write (chat, DM, roster, activities...), per user and per endpoint
RATE_WRITES=60
# 1 serves the OpenAPI page at /api/docs. Development only; leave 0 on the real server.
API_DOCS=0
